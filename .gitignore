# Isolated git worktrees for 4.0+ feature branches (see using-git-worktrees).
.worktrees/

# VSCode Ordner
.vscode/

# Claude Code Ordner: settings.json, settings.local.json und worktrees/ sind lokal.
# agents/ und hooks/ sind dagegen Projektwerkzeug und gehoeren ins Repo. Deshalb
# .claude/* statt .claude/ -- eine Negation kann eine Datei nicht zurueckholen,
# solange ihr Verzeichnis selbst ausgeschlossen ist.
.claude/*
!.claude/agents/
!.claude/hooks/

# Codex-Ordner: dasselbe Werkzeug wie .claude/, nur fuer einen anderen Client.
# Anders als dort komplett lokal -- kein Teil davon muss ins Repo.
.codex/

# Serena-Ordner: Projektkonfiguration und Symbolindex des Lua-Language-Servers.
# Wird beim ersten Lauf erzeugt und ist maschinengebunden -- gehoert nicht ins Repo.
.serena/

# Gepackte Addon-Archive
*.zip

# VSCode Workspace Dateien
*.code-workspace

# Interne Arbeitsnotizen (Plaene, Specs, Reviews) - bleiben lokal
docs/superpowers/

# Coverage output (KART_COVERAGE=1 luajit tests/run.lua)
luacov.stats.out
luacov.report.out

# Arbeitsverzeichnis der subagent-driven-development-Laeufe (Ledger, Briefings,
# Berichte, Review-Diffs). Reines Geruest: die Diagnosen, die bleiben sollen,
# stehen in docs/BACKLOG.md und in den Kommentaren am Code.
.superpowers/

# Local 3.x loot council archive (not shipped, not committed)
archive/
