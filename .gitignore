# Isolated git worktrees for 4.0+ feature branches (see using-git-worktrees).
.worktrees/

# VSCode Ordner
.vscode/

# Cursor: Skills, Rules und sonstige IDE-Konfiguration bleiben lokal.
.cursor/

# Claude Code: komplett lokal.
.claude/

# Codex-Ordner: komplett lokal.
.codex/

# Serena-Ordner: Projektkonfiguration und Symbolindex des Lua-Language-Servers.
# Wird beim ersten Lauf erzeugt und ist maschinengebunden -- gehoert nicht ins Repo.
.serena/

# Gepackte Addon-Archive
*.zip

# VSCode Workspace Dateien
*.code-workspace

# Interne Arbeitsnotizen, Domain-Docs und Agent-Anleitungen -- lokal.
docs/
CLAUDE.md
AGENTS.md
CODING_STANDARDS.md
CONTEXT.md

# Coverage output (KART_COVERAGE=1 luajit tests/run.lua)
luacov.stats.out
luacov.report.out

# Arbeitsverzeichnis der subagent-driven-development-Laeufe (Ledger, Briefings,
# Berichte, Review-Diffs). Reines Geruest; Diagnosen die bleiben sollen stehen
# in lokalen docs/ und in den Kommentaren am Code.
.superpowers/

# Local 3.x loot council archive (not shipped, not committed)
archive/
